# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time —
# RESTART Metro (`npx expo start`) after editing this file.

# ── Scenario 1: iOS simulator or Expo web on this Mac (default) ───────────
EXPO_PUBLIC_EDGE_URL=http://localhost:8787
# Android emulator on this Mac: use http://10.0.2.2:8787 instead.

# ── Scenario 2: physical phone on the SAME Wi-Fi (LAN) ────────────────────
# Point at this Mac's LAN IP (find it with: ipconfig getifaddr en0), e.g.:
# EXPO_PUBLIC_EDGE_URL=http://192.168.1.23:8787

# ── Scenario 3: friend's phone over the INTERNET (tunnel) ─────────────────
# Start the backend with `npx pnpm@9.15.4 dev:all -- --tunnel` (or
# `infra/dev-all.sh --tunnel`) and paste the trycloudflare URL it prints:
# EXPO_PUBLIC_EDGE_URL=https://some-random-words.trycloudflare.com
# …then run Metro with `npx expo start --tunnel` on the phone side too.

# ── Optional development rehearsal (isolated dev backend only) ────────────
# Explore remains read-only without onboarding. This flag AND a __DEV__ build
# enable /demo, simulated GPS/evidence references, and biometric stub buttons.
# Never enable it against a real or shared production backend.
# EXPO_PUBLIC_DEMO_MODE=true

# ── Buyer checkout collection (Flutterwave) ───────────────────────────────
# Public key — embed-safe. When set, the checkout screen collects payment
# (card / bank transfer / USSD) before confirming; the charge is confirmed
# server-side via the edge's /payments proxy. Unset = unpaid dev checkout
# (matches the edge's PAYMENTS_REQUIRED=off dev default).
# EXPO_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
