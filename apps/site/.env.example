# Market Runs brand site — configuration. Copy to apps/site/.env for local dev (gitignored);
# on Vercel, set the same names in Project Settings → Environment Variables.

# Public base URL of this site. In production: https://<your-domain> — it is also the
# better-auth base URL that magic links point back to.
SITE_BASE_URL=http://localhost:8795

# better-auth session secret, at least 32 random chars.
# Generate one with: openssl rand -base64 48
# (In development an ephemeral secret is generated and stored in .data/dev-secret when unset.)
BETTER_AUTH_SECRET=

# Comma-separated admin allowlist. Only these addresses receive magic links and can open
# /inbox. One admin for now:
ADMIN_EMAILS=founder@market-runs.example

# Database. Local dev needs nothing (node:sqlite under .data/). For Vercel, set a Postgres
# connection string — Neon works well:
# SITE_DATABASE_URL=postgres://user:pass@host/db?sslmode=require
SITE_DATABASE_URL=
SITE_DATABASE_PATH=

# Resend — the email pipeline.
# API key: sends magic links AND fetches full bodies of received emails:
RESEND_API_KEY=
# From address on your verified Resend domain, used for magic links:
RESEND_FROM_EMAIL=Market Runs <hello@market-runs.example>
# Webhook signing secret from the Resend dashboard (starts with whsec_).
# Without it, POST /api/webhooks/resend answers 503 and nothing is stored.
RESEND_WEBHOOK_SECRET=

# The inbound address you configured on your Resend domain (shown on the site) —
# the address to submit to the Smile ID lead pipeline.
INBOUND_EMAIL_ADDRESS=hello@market-runs.example
