{
  "name": "market-runs",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:all": "bash infra/dev-all.sh",
    "dev:stop": "bash infra/dev-servers.sh --stop",
    "test": "pnpm --filter @market-runs/domain test && pnpm --filter @market-runs/proto test",
    "test:e2e": "node infra/e2e-session.mjs",
    "test:stack": "node infra/rehearse-stack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4"
  },
  "pnpm": {
    "overrides": {
      "better-call>zod": "^4.0.0"
    }
  }
}
